{
  "name": "sapilot",
  "displayName": "SAPilot",
  "description": "Add SAP AI Core models to GitHub Copilot Chat. Connect once, then choose a running deployment.",
  "version": "0.1.18",
  "publisher": "sharma-so",
  "author": "Rahul Sharma",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": ">=1.104.0"
  },
  "categories": ["AI", "Machine Learning"],
  "keywords": ["SAP", "SAP AI Core", "chat models", "Claude", "Gemini", "Cohere"],
  "main": "extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:sap-ai-core"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "sap-ai-core",
        "displayName": "SAP AI Core",
        "managementCommand": "sap-ai-core-chat.configure"
      }
    ],
    "commands": [
      {
        "command": "sap-ai-core-chat.configure",
        "title": "SAPilot: Connect to SAP AI Core"
      }
    ],
    "walkthroughs": [
      {
        "id": "sapAiCoreGettingStarted",
        "title": "Get started with SAPilot",
        "description": "Connect SAP AI Core and use its models in GitHub Copilot Chat.",
        "steps": [
          {
            "id": "connect",
            "title": "Connect SAP AI Core",
            "description": "Add your SAP AI Core connection details once. They are saved for next time.",
            "media": {
              "markdown": "resources/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:sap-ai-core-chat.configure"
            ]
          },
          {
            "id": "chooseModel",
            "title": "Choose a model in Copilot Chat",
            "description": "Select a running SAP AI Core model from Chat’s model picker.",
            "media": {
              "markdown": "resources/walkthrough/choose-model.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.chat.open"
            ]
          }
        ]
      }
    ]
  }
}
